{
  "name": "campus-plus-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serveur Campus+ : synchro WebAurion, Moodle et mails, à héberger soi-même (NAS).",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "essai": "tsx src/essai.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx test/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "cheerio": "^1.0.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
