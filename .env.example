# Copie ce fichier en .env sur le serveur (jamais dans Git)
PORT=8787
# Clé de chiffrement des données au repos (32 octets en base64) : openssl rand -base64 32
# Si tu la perds ou la changes, les comptes enregistrés deviennent illisibles (chacun devra se reconnecter).
CAMPUS_SECRET_KEY=
# Dossier où sont rangées les données (chiffrées) et, plus tard, les fichiers des cours
DATA_DIR=./data
# Minutes entre deux synchros automatiques d'un même élève (5 minimum)
SYNC_MINUTES=15
# Mettre « false » seulement pour un essai en local sans HTTPS
COOKIE_SECURE=true
# Mettre « false » si le serveur est exposé directement, sans proxy inversé devant
TRUST_PROXY=true
# Tri IA des mails (optionnel, pas encore utilisé) : clé d'API du modèle
AI_API_KEY=
