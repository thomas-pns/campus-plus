# Copie ce fichier en .env sur le serveur (jamais dans Git)
PORT=8787
# Clé de chiffrement des identifiants au repos (32 octets en base64) : openssl rand -base64 32
CAMPUS_SECRET_KEY=
# Dossier où sont rangés les fichiers des cours synchronisés
DATA_DIR=./data
# Tri IA des mails (optionnel) : clé d'API du modèle utilisé
AI_API_KEY=
